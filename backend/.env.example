# Copy the root .env.example to the project root and replace this example secret.
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters-long
JWT_EXPIRE_MINUTES=720
DATABASE_URL=sqlite:///./skillswap.db
FRONTEND_ORIGIN=http://localhost:5500
UPLOAD_DIR=uploads
MAX_IMAGE_MB=5
MAX_VIDEO_MB=50
MAX_EXCHANGES_PER_COMBINATION=2
ADMIN_EMAIL=
ADMIN_PASSWORD=
RATE_LIMIT_AUTH=5/minute
